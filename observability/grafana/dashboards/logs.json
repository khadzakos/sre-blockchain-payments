{
  "uid": "payments-logs",
  "title": "Payments · Logs & traces",
  "schemaVersion": 41,
  "version": 3,
  "editable": false,
  "tags": ["sre", "victorialogs"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Application logs",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "project:=\"sre-payments\"",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "HTTP responses with errors",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "project:=\"sre-payments\" service.name:=\"payments-api\" _msg:=\"http request\" status:>=400",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "title": "Logs by service and level",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "project:=\"sre-payments\" | stats by (service.name, level) count() as logs",
          "queryType": "stats",
          "editorMode": "code",
          "legendFormat": "{{service.name}} · {{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["lastNotNull"],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Service · level",
              "Last": "Logs",
              "Last *": "Logs"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Top HTTP routes",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "project:=\"sre-payments\" service.name:=\"payments-api\" route:* | stats by (route) count() as hits | sort by (hits) desc | limit 5",
          "queryType": "stats",
          "editorMode": "code",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["lastNotNull"],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Route",
              "Last": "Logs",
              "Last *": "Logs"
            }
          }
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Search logs",
      "type": "link",
      "url": "/explore",
      "targetBlank": false
    }
  ]
}
